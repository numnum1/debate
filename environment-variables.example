# Beispiel Umgebungsvariablen für den Debate Server
# Kopieren Sie diese Datei und passen Sie die Werte an Ihre Umgebung an

# MongoDB Configuration
MONGODB_URI=mongodb://admin:password@localhost:27017/debate?authSource=admin
MONGODB_DATABASE=debate

# Alternative Zugangsdaten (falls gewünscht):
# MONGODB_URI=mongodb://debateuser:debatepass@localhost:27017/debate?authSource=debate

# Keycloak Configuration
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/debate
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/debate/protocol/openid-connect/certs
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Server Configuration
SERVER_PORT=8080

# EECC API Configuration
EECC_API_BASE_URL=https://api.eecc.ai/v1
EECC_API_KEY=your-eecc-api-key-here

# Diese Variablen können in der application.yml oder als Umgebungsvariablen verwendet werden
# Beispiel: export KEYCLOAK_CLIENT_SECRET=ihr-secret
# Beispiel: export EECC_API_KEY=25m7b22W5Z6dwraEc3waKjVpa7YdKZQVko3pd1L9LLR

