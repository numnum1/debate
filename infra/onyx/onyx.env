# Variablen für die Onyx-Compose-Datei (siehe onyx-main/deployment/docker_compose/env.template).

# Version der Onyx-Images. Für reproduzierbare Umgebungen auf eine feste Version setzen (z. B. v3.x.y).
IMAGE_TAG=v4.9.3

# Onyx-Oberfläche und API: http://localhost:3000. Port 80 bleibt frei.
HOST_PORT=3000
HOST_PORT_80=3080

# Login für die Onyx-Admin-Oberfläche: E-Mail/Passwort. Endnutzer melden sich nie bei Onyx an.
AUTH_TYPE=basic

# Signiert Onyx-interne Tokens (Passwort-Reset, OAuth-State). Fester Wert NUR für lokale Entwicklung,
# auf jedem Server durch `openssl rand -hex 32` ersetzen.
USER_AUTH_SECRET=local-dev-only-not-a-secret

# Dateien in Onyx' eigener Postgres statt in einem S3-Objektspeicher ablegen: zwei Container und RAM weniger.
# (Mit COMPOSE_PROFILES=s3-filestore und FILE_STORE_BACKEND=s3 käme der Objektspeicher dazu.)
FILE_STORE_BACKEND=postgres
