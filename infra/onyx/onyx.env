# Variablen für die Onyx-Compose-Dateien (siehe onyx-main/deployment/docker_compose/env.template).

# Version der Onyx-Images, fest eingestellt für reproduzierbare Umgebungen.
IMAGE_TAG=v4.9.3

# Onyx-API direkt (immer): http://localhost:3001
ONYX_API_PORT=3001

# Onyx-Admin-Oberfläche (nur mit Profil admin-ui): http://localhost:3000. Port 80 bleibt frei.
HOST_PORT=3000
HOST_PORT_80=3080

# Login für die Onyx-Admin-Oberfläche: E-Mail/Passwort. Endnutzer melden sich nie bei Onyx an.
AUTH_TYPE=basic

# nginx soll keine Routen für den abgeschalteten MCP-Server anlegen.
MCP_SERVER_ENABLED=false

# Signiert Onyx-interne Tokens (Passwort-Reset, OAuth-State). Fester Wert NUR für lokale Entwicklung,
# auf jedem Server durch `openssl rand -hex 32` ersetzen.
USER_AUTH_SECRET=local-dev-only-not-a-secret
